DOMA_API_TOKEN=                 # 외부 데이터 API(/api/v1/**) 인증 토큰
APP_BASE_URL=                   # 대시보드 공개 주소. 자가치유 알림의 "다시 선택하기" 링크에 쓰인다

# 셀렉터가 나타나기를 기다리는 시간(ms). 기본 40000. 시연 때 8000으로 낮추면 고장이 즉시 드러난다.
SELECTOR_WAIT_MS=
